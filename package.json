{
  "name": "dust-off",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "description": "A privacy-first randomized photo gallery and slideshow for iOS and Android. Rediscover the photos you forgot you had — local-only, no cloud, no telemetry.",
  "keywords": [
    "expo",
    "react-native",
    "ios",
    "android",
    "photo-gallery",
    "slideshow",
    "privacy",
    "local-first",
    "expo-router",
    "media-library"
  ],
  "homepage": "https://github.com/Ninkuk/dust-off#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ninkuk/dust-off.git"
  },
  "bugs": {
    "url": "https://github.com/Ninkuk/dust-off/issues"
  },
  "author": "Ninad Kulkarni",
  "license": "MIT",
  "scripts": {
    "start": "expo start",
    "start:tunnel": "expo start --tunnel",
    "stop": "lsof -ti:8081 | xargs kill -9 2>/dev/null || true",
    "android": "expo run:android",
    "android:release": "expo run:android --variant release --device",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "fixtures:fetch": "node scripts/fetch-fixtures.mjs",
    "seed:android": "bash scripts/seed-android-emulator.sh",
    "seed:ios": "bash scripts/seed-ios-simulator.sh",
    "lint": "expo lint",
    "react-doctor": "npx react-doctor@latest"
  },
  "dependencies": {
    "@gorhom/bottom-sheet": "^5.2.14",
    "@nandorojo/galeria": "^3.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.15.5",
    "@react-navigation/elements": "^2.9.10",
    "@react-navigation/native": "^7.1.33",
    "@shopify/flash-list": "2.0.2",
    "@shopify/react-native-skia": "2.4.18",
    "@tanstack/react-query": "^5.100.9",
    "expo": "~55.0.23",
    "expo-build-properties": "~55.0.13",
    "expo-constants": "~55.0.16",
    "expo-dev-client": "~55.0.32",
    "expo-device": "~55.0.16",
    "expo-file-system": "~55.0.22",
    "expo-font": "~55.0.7",
    "expo-glass-effect": "~55.0.11",
    "expo-haptics": "~55.0.14",
    "expo-image": "~55.0.10",
    "expo-keep-awake": "~55.0.8",
    "expo-linear-gradient": "~55.0.14",
    "expo-linking": "~55.0.15",
    "expo-media-library": "~55.0.16",
    "expo-router": "~55.0.14",
    "expo-sharing": "~55.0.20",
    "expo-splash-screen": "~55.0.20",
    "expo-status-bar": "~55.0.6",
    "expo-symbols": "~55.0.8",
    "expo-system-ui": "~55.0.17",
    "expo-web-browser": "~55.0.15",
    "lucide-react-native": "^1.14.0",
    "react": "19.2.7",
    "react-dom": "19.2.0",
    "react-native": "0.83.6",
    "react-native-animated-glow": "^3.1.0",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-share": "^12.3.1",
    "react-native-svg": "15.15.3",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.7.4",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@types/react": "~19.2.17",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~55.0.0",
    "typescript": "~5.9.2"
  },
  "overrides": {
    "postcss": "^8.5.10"
  },
  "private": true
}
